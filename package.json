{
    "name": "graymatter",
    "private": true,
    "version": "0.1.0",
    "description": "Chess opening trainer",
    "author": "graymatter",
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
        "dev:web": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "package": "npm run build && electron-builder --win"
    },
    "dependencies": {
        "@jackstenglein/pgn-parser": "^2.0.13",
        "chess.js": "^1.0.0",
        "react": "^19.2.7",
        "react-chessboard": "^5.10.0",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.14",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^9.2.1",
        "electron": "^37.2.5",
        "electron-builder": "^26.0.12",
        "tailwindcss": "^4.0.14",
        "typescript": "~5.7.3",
        "vite": "^6.2.0",
        "wait-on": "^8.0.4"
    },
    "build": {
        "appId": "com.graymatter.trainer",
        "productName": "GrayMatter",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
